{
  "name": "Labtime Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:2.1.13-trixie",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.0",
      "golangciLintVersion": "2.13.1"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/yamllint:2": {},
    "ghcr.io/devcontainers-extra/features/markdownlint-cli2:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "EditorConfig.EditorConfig",
        "DavidAnson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "MermaidChart.vscode-mermaid-chart",
        "github.vscode-github-actions"
      ]
    }
  }
}
